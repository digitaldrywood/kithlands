[
  {
    "id": "old-mill",
    "title": "The Old Mill of {locality}",
    "entry_label": "Old Mill trail",
    "description": "The millrace has fallen quiet. Follow the split oak and the kingfisher bend to the old mill above {locality}. You can retreat or save at any safe moment.",
    "entry_room": "approach",
    "entry_position": {
      "x": 12,
      "y": 12
    },
    "complete_flag": "mill-reward",
    "return_text": "The millrace sings again. The people of {locality} thank you with 80 gold. Your Ember Gem can be fitted to a socketed weapon or armor from the Party menu; the restored trail remains open.",
    "retreat_text": "You return to {locality}. Your discoveries and opened routes are remembered.",
    "defeat_text": "The trail keeper brings your party back to the split oak. Rested and safe, you can try again; your discoveries remain.",
    "payoff": {
      "gold": 80
    },
    "objectives": [
      {
        "until": "trail-bats-cleared",
        "text": "Follow the split oak and kingfisher bend. Clear the bats at the wagon road."
      },
      {
        "until": "handle-found",
        "text": "Read the ledger. Search the grain store for the spare wheel handle."
      },
      {
        "until": "wheel-restored",
        "text": "Fit the spare handle in the wheel house. The drying room holds supplies."
      },
      {
        "until": "sluice-open",
        "text": "Clear the gallery and open the sluice. Look for a way back along the tailrace."
      },
      {
        "until": "warden-cleared",
        "text": "Rest at the keeper\u2019s bench. With water flowing, calm the Millroot Warden in the mill heart."
      },
      {
        "until": "mill-reward",
        "text": "Claim the miller\u2019s keepsake beside the mill heart."
      },
      {
        "until": "",
        "text": "Return to town with the good news. The tailrace shortcut leads home."
      }
    ],
