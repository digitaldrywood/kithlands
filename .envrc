# Per-worktree isolation (ports + database). See CLAUDE.md > Worktree Isolation.
# This file is committed. It contains NO secrets — it only sources the
# deterministic offset script and optional worktree-local overrides.

# Compute PORT / VITE_PORT / DB_NAME / DATABASE_URL from md5($PWD).
# scripts/worktree-env.sh is plain bash, safe to source directly inside direnv.
source scripts/worktree-env.sh

# Optional worktree-local secrets (TAILSCALE_HOSTNAME, GEMINI_API_KEY, etc).
# Create .envrc.local from .envrc.example; it is gitignored.
if [ -f .envrc.local ]; then
  source .envrc.local
fi
